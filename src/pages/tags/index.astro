---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: "Every topic I've written under, with the count of entries filed against each.",
	title: "Tags",
	ogImage: "/og-image/tags.png",
};
---

<PageLayout meta={meta}>
	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">Index — Topics</p>
		<h1 class="lb-chapter-heading">Tags</h1>
		<p class="lb-chapter-lead">
			Every topic I've written under, with the count of entries filed against each.
		</p>
	</header>

	<ul class="tag-list" role="list">
		{
			allTags.map(([tag, count]) => (
				<li class="tag-row">
					<a class="tag-link" href={`/tags/${tag}/`}>
						<span aria-hidden="true" class="tag-marker">
							#
						</span>
						<span class="tag-name">{tag}</span>
						<span class="tag-count">
							{String(count).padStart(2, "0")}
							<span class="sr-only">{count > 1 ? " posts" : " post"}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.tag-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-global-text);
	}
	.tag-row {
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
	}
	.tag-link {
		display: grid;
		grid-template-columns: 1.75rem 1fr auto;
		align-items: baseline;
		column-gap: 1rem;
		padding: 1.4rem 0.25rem;
		text-decoration: none;
		color: var(--color-global-text);
		transition:
			color 250ms ease,
			padding-left 350ms cubic-bezier(0.2, 0.6, 0.2, 1);
	}
	.tag-link:hover {
		color: var(--color-accent);
		padding-left: 0.75rem;
	}
	.tag-marker {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		font-weight: 600;
		align-self: center;
	}
	.tag-link:hover .tag-marker {
		color: var(--color-accent);
	}
	.tag-name {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw + 0.25rem, 2.25rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.05;
		font-variation-settings:
			"opsz" 36,
			"SOFT" 30,
			"WONK" 0;
	}
	.tag-count {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		color: var(--color-muted);
		align-self: center;
	}
	@media (min-width: 880px) {
		.tag-link {
			padding: 2rem 0.5rem;
		}
	}
</style>
