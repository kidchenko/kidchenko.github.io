---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getTagMeta, getUniqueTags } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(sortedPosts);

	return uniqueTags.flatMap((tag) => {
		const postsWithTag = sortedPosts.filter((post) => post.data.tags.includes(tag));
		return paginate(postsWithTag, {
			pageSize: 10,
			params: { tag },
		});
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { tag } = Astro.params;
const tagMeta = await getTagMeta(tag);

const TagContent = tagMeta ? (await render(tagMeta)).Content : null;

const meta = {
	description: tagMeta?.data.description ?? `Posts tagged "${tag}".`,
	title: tagMeta?.data.title ?? `Posts tagged "${tag}"`,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: { text: "← Previous Page", url: page.url.prev },
	}),
	...(page.url.next && {
		nextUrl: { text: "Next Page →", url: page.url.next },
	}),
};
---

<PageLayout meta={meta}>
	<nav aria-label="Breadcrumbs" class="tg-crumbs">
		<a class="tg-crumbs-link" href="/tags/">Tags</a>
		<span aria-hidden="true" class="tg-crumbs-sep">/</span>
		<span class="tg-crumbs-current">
			<span aria-hidden="true">#</span>{tag}
		</span>
	</nav>

	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">Tag — #{tag}</p>
		<h1 class="lb-chapter-heading">{tagMeta?.data.title ?? `Posts on ${tag}`}</h1>
		{
			(tagMeta?.data.description || TagContent) && (
				<div class="lb-prose tg-intro">
					{tagMeta?.data.description && <p>{tagMeta.data.description}</p>}
					{TagContent && <TagContent />}
				</div>
			)
		}
	</header>

	<ul class="tg-list" role="list">
		{
			page.data.map((p) => (
				<li class="tg-entry">
					<FormattedDate class="tg-entry-date" date={p.data.publishDate} />
					<div class="tg-entry-body">
						<h2 class="tg-entry-title">
							{p.data.draft && <span class="tg-entry-draft">(Draft) </span>}
							<a href={`/posts/${p.id}/`}>{p.data.title}</a>
						</h2>
						{p.data.description && <p class="tg-entry-desc">{p.data.description}</p>}
					</div>
				</li>
			))
		}
	</ul>

	<Pagination {...paginationProps} />
</PageLayout>

<style>
	/* Breadcrumb — small mono caps with accent */
	.tg-crumbs {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 2.5rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
	.tg-crumbs-link {
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 600;
		transition: color 200ms ease;
	}
	.tg-crumbs-link:hover {
		color: var(--color-accent-2);
	}
	.tg-crumbs-sep {
		color: var(--color-muted);
	}
	.tg-crumbs-current {
		color: var(--color-global-text);
		font-weight: 500;
	}

	.tg-intro {
		margin-top: 1.25rem;
	}

	/* Post list — log entry pattern, matching the writing page */
	.tg-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.tg-entry {
		padding: 1.5rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
	}
	@media (min-width: 880px) {
		.tg-entry {
			grid-template-columns: 9rem 1fr;
			gap: 3rem;
			padding: 1.85rem 0;
			align-items: baseline;
		}
	}
	.tg-entry-date {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		font-weight: 500;
	}
	.tg-entry-title {
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 1.4vw + 0.6rem, 1.625rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.015em;
		margin: 0;
		font-variation-settings:
			"opsz" 30,
			"SOFT" 30,
			"WONK" 0;
		text-wrap: pretty;
	}
	.tg-entry-title a {
		color: var(--color-global-text);
		text-decoration: none;
		background-image: linear-gradient(to right, var(--color-accent), var(--color-accent));
		background-repeat: no-repeat;
		background-size: 0% 1px;
		background-position: left bottom -0.05em;
		transition:
			background-size 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
			color 200ms ease;
	}
	.tg-entry-title a:hover {
		color: var(--color-accent);
		background-size: 100% 1px;
	}
	.tg-entry-draft {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 600;
		margin-right: 0.4rem;
	}
	.tg-entry-desc {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0.6rem 0 0;
		font-variation-settings:
			"opsz" 16,
			"SOFT" 60;
		max-width: 60ch;
	}
</style>
