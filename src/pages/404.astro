---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Off the chart — the page you were looking for is not here.",
	title: "Off the chart",
};
---

<PageLayout meta={meta}>
	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">404 — Off the chart</p>
		<h1 class="lb-chapter-heading">This page is not on the map.</h1>
		<p class="lb-chapter-lead">
			It may have been moved, renamed, or never existed. Use the navigation above
			to get your bearings.
		</p>
	</header>
</PageLayout>
