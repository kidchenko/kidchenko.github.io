---
import PageLayout from "@/layouts/Base.astro";
import { type Lang, languages } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang: lang === "en" ? undefined : lang },
		props: { lang: lang as Lang },
	}));
}

const { lang } = Astro.props;
const t = useTranslations(lang).contact;
const meta = { title: t.meta.title, description: t.meta.description };
---

<PageLayout meta={meta}>
	<h1 class="title mb-4 text-3xl sm:text-4xl">{t.heading}</h1>
	<p class="text-muted mb-12">{t.lead}</p>

	<form
		action="https://formspree.io/f/mzdozjng"
		class="space-y-6"
		id="contact-form"
		method="POST"
		data-success={t.form.success}
		data-error={t.form.error}
		data-sending={t.form.sending}
		data-submit={t.form.submit}
	>
		<div>
			<label class="contact-label" for="name">{t.form.name}</label>
			<input autocomplete="name" class="contact-input" id="name" name="name" required type="text" />
		</div>

		<div>
			<label class="contact-label" for="email">{t.form.email}</label>
			<input
				autocomplete="email"
				class="contact-input"
				id="email"
				name="email"
				required
				type="email"
			/>
		</div>

		<div>
			<label class="contact-label" for="subject">
				{t.form.subject}{" "}
				<span class="text-muted text-xs">{t.form.subjectOptional}</span>
			</label>
			<input class="contact-input" id="subject" name="subject" type="text" />
		</div>

		<div>
			<label class="contact-label" for="message">{t.form.message}</label>
			<textarea
				class="contact-input min-h-40 resize-y"
				id="message"
				name="message"
				required
				rows="6"></textarea>
		</div>

		<div aria-hidden="true" class="hidden">
			<label for="website">{t.form.honeypotLabel}</label>
			<input id="website" name="_gotcha" tabindex="-1" type="text" />
		</div>

		<div id="form-feedback" aria-live="polite" class="text-sm"></div>

		<button class="contact-submit" type="submit">{t.form.submit}</button>
	</form>

	<hr class="border-global-text/10 my-16" />

	<section>
		<h2 class="title mb-6 text-xl">{t.other.heading}</h2>
		<div class="prose prose-cactus max-w-none">
			<ul>
				{
					t.other.items.map((item) => (
						<li>
							<a href={item.url} rel="noreferrer" target="_blank">
								{item.name}
							</a>
							{` - ${item.note}`}
						</li>
					))
				}
			</ul>
			<p class="text-muted text-sm">{t.other.footnote}</p>
		</div>
	</section>
</PageLayout>

<style>
	.contact-label {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		margin-bottom: 0.4rem;
		color: var(--color-global-text);
	}
	.contact-input {
		display: block;
		width: 100%;
		padding: 0.65rem 0.9rem;
		border: 1px solid var(--color-global-text);
		border-opacity: 0.2;
		border-color: color-mix(in oklch, var(--color-global-text) 20%, transparent);
		border-radius: 4px;
		background: transparent;
		color: var(--color-global-text);
		font-family: inherit;
		font-size: 0.95rem;
		transition: border-color 150ms ease;
	}
	.contact-input:focus {
		outline: none;
		border-color: var(--color-accent);
	}
	.contact-submit {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.5rem;
		background: var(--color-accent);
		color: var(--color-global-bg);
		border-radius: 4px;
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
		border: none;
		transition: opacity 150ms ease;
	}
	.contact-submit:hover {
		opacity: 0.9;
	}
	.contact-submit:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const feedback = document.getElementById("form-feedback");
	const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	if (form && feedback && submitBtn) {
		const successMsg = form.dataset.success ?? "Message sent.";
		const errorMsg = form.dataset.error ?? "Something went wrong.";
		const sendingMsg = form.dataset.sending ?? "Sending...";
		const submitMsg = form.dataset.submit ?? "Send message";

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			feedback.textContent = "";
			feedback.className = "text-sm";
			submitBtn.disabled = true;
			submitBtn.textContent = sendingMsg;

			try {
				const response = await fetch(form.action, {
					method: "POST",
					body: new FormData(form),
					headers: { Accept: "application/json" },
				});

				if (response.ok) {
					feedback.textContent = successMsg;
					feedback.className = "text-sm font-semibold text-green-700 dark:text-green-400";
					form.reset();
				} else {
					throw new Error("Form submission failed");
				}
			} catch {
				feedback.textContent = errorMsg;
				feedback.className = "text-sm font-semibold text-red-700 dark:text-red-400";
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = submitMsg;
			}
		});
	}
</script>
