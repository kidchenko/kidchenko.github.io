---
import { Image } from "astro:assets";
import casual from "@/assets/img/jose-casual.png";
import { type Lang, languages } from "@/i18n/ui";
import { localizeUrl, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang: lang === "en" ? undefined : lang },
		props: { lang: lang as Lang },
	}));
}

const { lang } = Astro.props;
const t = useTranslations(lang).about;
const meta = {
	title: t.meta.title,
	description: t.meta.description,
};
const contactUrl = localizeUrl("/contact", lang);
---

<PageLayout meta={meta}>
	{/* Editorial hero: eyebrow + page title + serif standfirst + portrait.
	    Tight bottom margin because the standfirst leads into the body it introduces. */}
	<header class="mb-8 sm:mb-10">
		<div class="grid gap-10 sm:grid-cols-[1fr_14rem] sm:items-end sm:gap-12">
			<div>
				<p class="page-eyebrow mb-5">{t.eyebrow}</p>
				<h1 class="page-title">{t.heading}</h1>
				<p class="standfirst mt-6 max-w-prose">{t.hi}</p>
			</div>
			<div class="not-prose">
				<Image
					alt={t.photoAlt}
					class="photo-fade w-full rounded-lg object-cover"
					sizes="(min-width: 640px) 224px, 280px"
					src={casual}
					widths={[280, 448]}
				/>
			</div>
		</div>
	</header>

	{/* Bio narrative */}
	<div class="prose prose-cactus max-w-none">
		{t.intro.map((p) => <p>{p}</p>)}
	</div>

	{/* Now */}
	<section class="mt-20 border-t border-global-text/10 pt-16 sm:mt-24 sm:pt-20">
		<h2 class="section-heading mb-8">{t.now.heading}</h2>
		<div class="prose prose-cactus max-w-none">
			<ul>
				{t.now.items.map((item) => <li set:html={item} />)}
			</ul>
		</div>
	</section>

	{/* Beyond engineering */}
	<section class="mt-20 border-t border-global-text/10 pt-16 sm:mt-24 sm:pt-20">
		<h2 class="section-heading mb-8">{t.beyond.heading}</h2>
		<div class="prose prose-cactus max-w-none">
			{t.beyond.body.map((p) => <p set:html={p} />)}
		</div>
	</section>

	{/* Reading & interests */}
	<section class="mt-20 border-t border-global-text/10 pt-16 sm:mt-24 sm:pt-20">
		<h2 class="section-heading mb-8">{t.reading.heading}</h2>
		<div class="prose prose-cactus max-w-none">
			<p>{t.reading.lead}</p>
			<ul>
				{t.reading.items.map((item) => <li set:html={item} />)}
			</ul>
			<p>{t.reading.closing}</p>
		</div>
	</section>

	{/* Connect */}
	<section class="mt-20 border-t border-global-text/10 pt-16 sm:mt-24 sm:pt-20">
		<h2 class="section-heading mb-8">{t.connect.heading}</h2>
		<div class="prose prose-cactus max-w-none">
			<p set:html={t.connect.body.replace("{contactUrl}", contactUrl)} />
		</div>
	</section>
</PageLayout>
