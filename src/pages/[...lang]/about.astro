---
import { Image } from "astro:assets";
import casual from "@/assets/img/jose-casual.png";
import { type Lang, languages } from "@/i18n/ui";
import { localizeUrl, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang: lang === "en" ? undefined : lang },
		props: { lang: lang as Lang },
	}));
}

const { lang } = Astro.props;
const t = useTranslations(lang).about;
const meta = {
	title: t.meta.title,
	description: t.meta.description,
	ogImage: "/og-image/about.png",
};
const contactUrl = localizeUrl("/contact", lang);

const isPt = lang === "pt";
const ui = isPt
	? {
			chapterEyebrow: "II — O Capitão",
			portraitCaption: "São Paulo, MMXXVI",
		}
	: {
			chapterEyebrow: "II — The Captain",
			portraitCaption: "São Paulo, MMXXVI",
		};
---

<PageLayout meta={meta}>
	{/* ─── Chapter title ────────────────────────────────────────── */}
	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">{ui.chapterEyebrow}</p>
		<h1 class="lb-chapter-heading">{t.hi}</h1>
	</header>

	{/* ─── Frontispiece photo (full-bleed band) ──────────────────── */}
	<figure class="ab-frontispiece lb-fullbleed">
		<Image
			alt={t.photoAlt}
			class="ab-photo"
			loading="eager"
			sizes="100vw"
			src={casual}
			widths={[640, 1024, 1600, 2000]}
		/>
		<figcaption class="ab-caption">{ui.portraitCaption}</figcaption>
	</figure>

	{/* ─── Bio narrative ─────────────────────────────────────────── */}
	<div class="lb-prose ab-intro-prose">
		{t.intro.map((p) => <p>{p}</p>)}
	</div>

	{/* ─── i. Now ────────────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">i</p>
			<h2 class="lb-section-heading">{t.now.heading}</h2>
		</header>
		<ul class="ab-now-list">
			{t.now.items.map((item) => <li class="ab-now-item" set:html={item} />)}
		</ul>
	</section>

	{/* ─── ii. Beyond engineering ────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">ii</p>
			<h2 class="lb-section-heading">{t.beyond.heading}</h2>
		</header>
		<div class="lb-prose">
			{t.beyond.body.map((p) => <p set:html={p} />)}
		</div>
	</section>

	{/* ─── iii. Reading & interests ──────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">iii</p>
			<h2 class="lb-section-heading">{t.reading.heading}</h2>
		</header>
		<p class="ab-reading-lead">{t.reading.lead}</p>
		<ul class="ab-reading-list">
			{t.reading.items.map((item) => <li class="ab-reading-item" set:html={item} />)}
		</ul>
		<p class="ab-reading-closing">{t.reading.closing}</p>
	</section>

	{/* ─── iv. Connect ───────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">iv</p>
			<h2 class="lb-section-heading">{t.connect.heading}</h2>
		</header>
		<p class="lb-prose ab-connect" set:html={t.connect.body.replace("{contactUrl}", contactUrl)} />
	</section>
</PageLayout>

<style>
	/* Page-specific styles only. Shared chrome (chapter title,
	   sections, prose, full-bleed) lives in global.css under .lb-*. */

	/* Frontispiece — full-bleed band image with feathered bottom edge */
	.ab-photo {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: center 28%;
		display: block;
		mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 84%,
			rgba(0, 0, 0, 0.45) 95%,
			rgba(0, 0, 0, 0) 100%
		);
		-webkit-mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 84%,
			rgba(0, 0, 0, 0.45) 95%,
			rgba(0, 0, 0, 0) 100%
		);
	}
	@media (min-width: 880px) {
		.ab-photo {
			aspect-ratio: 16 / 7;
		}
	}
	.ab-caption {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		text-align: center;
		margin: 0.75rem 0 0;
	}

	/* Pull the bio prose up under the frontispiece caption */
	.ab-intro-prose {
		margin-top: 3rem;
	}

	/* Now list — hairline-divided rows */
	.ab-now-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.ab-now-item {
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-global-text);
		padding: 1.25rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		font-variation-settings: "opsz" 16;
	}
	.ab-now-item :global(strong) {
		font-weight: 600;
		color: var(--color-accent-2);
		margin-right: 0.25rem;
	}

	/* Reading list — catalog-style mono category labels */
	.ab-reading-lead,
	.ab-reading-closing {
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--color-global-text);
		margin: 0 0 1.5rem;
		font-variation-settings: "opsz" 16;
	}
	.ab-reading-closing {
		margin-top: 2rem;
		margin-bottom: 0;
		font-style: italic;
		color: var(--color-muted);
	}
	.ab-reading-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.ab-reading-item {
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-global-text);
		padding: 1.25rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		font-variation-settings: "opsz" 16;
	}
	.ab-reading-item :global(strong) {
		display: block;
		margin-bottom: 0.5rem;
		font-weight: 600;
		color: var(--color-accent-2);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	@media (min-width: 640px) {
		.ab-reading-item {
			padding: 0.95rem 0;
		}
		.ab-reading-item :global(strong) {
			display: inline;
			margin-bottom: 0;
			margin-right: 0.5rem;
			letter-spacing: 0.1em;
		}
	}
	.ab-reading-item :global(em) {
		font-style: italic;
	}

	/* Connect — slightly stronger underline on the contact link */
	.ab-connect :global(a) {
		color: var(--color-accent-2);
		text-decoration-color: var(--color-accent);
	}
</style>
