---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { type Lang, languages } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 10;
	const MAX_TAGS = 7;
	const MAX_PINNED_POSTS = 3;
	const allPosts = await getAllPosts();
	const allPostsByDate = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);
	const pinnedPosts = allPostsByDate
		.values()
		.filter((p) => p.data.pinned)
		.take(MAX_PINNED_POSTS)
		.toArray();

	return Object.keys(languages).flatMap((lang) =>
		paginate(allPostsByDate, {
			pageSize: MAX_POSTS_PER_PAGE,
			params: { lang: lang === "en" ? undefined : lang },
			props: { uniqueTags, pinnedPosts, lang: lang as Lang },
		}),
	);
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
	pinnedPosts: CollectionEntry<"post">[];
	lang: Lang;
}

const { page, uniqueTags, pinnedPosts, lang } = Astro.props;
const t = useTranslations(lang).writing;

const meta = { title: t.meta.title, description: t.meta.description };

const paginationProps = {
	...(page.url.prev && {
		prevUrl: { text: t.pagination.prev, url: page.url.prev },
	}),
	...(page.url.next && {
		nextUrl: { text: t.pagination.next, url: page.url.next },
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const isPt = lang === "pt";
const ui = isPt ? { chapterEyebrow: "V — Diário" } : { chapterEyebrow: "V — Logbook" };
---

<PageLayout meta={meta}>
	{/* ─── Chapter title ────────────────────────────────────────── */}
	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">{ui.chapterEyebrow}</p>
		<div class="wr-chapter-row">
			<h1 class="lb-chapter-heading">{t.heading}</h1>
			<a class="wr-rss" href="/rss.xml" target="_blank" rel="noreferrer">
				<span class="sr-only">{t.rssLabel}</span>
				<Icon aria-hidden="true" class="wr-rss-icon" focusable="false" name="mdi:rss" />
			</a>
		</div>
		<p class="lb-chapter-lead">{t.lead}</p>
	</header>

	{/* ─── Featured ─────────────────────────────────────────────── */}
	{
		pinnedPosts.length > 0 && (
			<section class="lb-section">
				<header class="lb-section-head">
					<h2 class="lb-section-heading">{t.featured}</h2>
				</header>
				<ul class="wr-list" role="list">
					{pinnedPosts.map((p) => (
						<li class="wr-entry">
							<FormattedDate class="wr-entry-date" date={p.data.publishDate} />
							<div class="wr-entry-body">
								<h3 class="wr-entry-title">
									{p.data.draft && <span class="wr-entry-draft">(Draft) </span>}
									<a href={`/posts/${p.id}/`}>{p.data.title}</a>
								</h3>
								{p.data.description && <p class="wr-entry-desc">{p.data.description}</p>}
							</div>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{/* ─── Year groups ──────────────────────────────────────────── */}
	{
		descYearKeys.map((yearKey) => (
			<section class="lb-section">
				<header class="lb-section-head">
					<h2 class="lb-section-heading wr-year-heading" id={`year-${yearKey}`}>
						<span class="sr-only">{t.postsInYear}</span>
						{yearKey}
					</h2>
				</header>
				<ul class="wr-list" role="list">
					{groupedByYear[yearKey]?.map((p) => (
						<li class="wr-entry">
							<FormattedDate class="wr-entry-date" date={p.data.publishDate} />
							<div class="wr-entry-body">
								<h3 class="wr-entry-title">
									{p.data.draft && <span class="wr-entry-draft">(Draft) </span>}
									<a href={`/posts/${p.id}/`}>{p.data.title}</a>
								</h3>
								{p.data.description && <p class="wr-entry-desc">{p.data.description}</p>}
							</div>
						</li>
					))}
				</ul>
			</section>
		))
	}

	<Pagination {...paginationProps} />

	{/* ─── Tags ─────────────────────────────────────────────────── */}
	{
		!!uniqueTags.length && (
			<section class="lb-section">
				<header class="lb-section-head">
					<h2 class="lb-section-heading">{t.tags}</h2>
				</header>
				<ul class="wr-tag-list" role="list">
					{uniqueTags.map((tag) => (
						<li>
							<a class="wr-tag" href={`/tags/${tag}/`}>
								<span aria-hidden="true">#</span>
								<span class="sr-only">{t.tags}</span>
								{tag}
							</a>
						</li>
					))}
				</ul>
				<a class="wr-tags-all" href="/tags/">
					{t.viewAll} <span aria-hidden="true">→</span>
					<span class="sr-only">{t.viewAllSr}</span>
				</a>
			</section>
		)
	}
</PageLayout>

<style>
	/* Page-specific styles. Shared chrome (lb-chapter, lb-section,
	   lb-prose, lb-fullbleed) + palette live in global.css. */

	/* Chapter row — heading sits inline with the RSS icon */
	.wr-chapter-row {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.wr-rss {
		color: var(--color-muted);
		transition: color 200ms ease;
	}
	.wr-rss:hover {
		color: var(--color-accent);
	}
	.wr-rss-icon {
		height: 1.5rem;
		width: 1.5rem;
	}

	/* Year heading uses the same scale as section headings but in
	   Fraunces — each year reads as a chapter break */
	.wr-year-heading {
		font-variation-settings: "opsz" 48, "SOFT" 30, "WONK" 0;
	}

	/* ============================================================
	   POST LIST — hairline-divided log entries.
	   On desktop: date in a side gutter (9rem) | title + desc.
	   On mobile: date stacks above the title.
	   ============================================================ */
	.wr-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.wr-entry {
		padding: 1.5rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
	}
	@media (min-width: 880px) {
		.wr-entry {
			grid-template-columns: 9rem 1fr;
			gap: 3rem;
			padding: 1.85rem 0;
			align-items: baseline;
		}
	}
	.wr-entry-date {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		font-weight: 500;
	}
	.wr-entry-title {
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 1.4vw + 0.6rem, 1.625rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.015em;
		margin: 0;
		font-variation-settings: "opsz" 30, "SOFT" 30, "WONK" 0;
		text-wrap: pretty;
	}
	.wr-entry-title a {
		color: var(--color-global-text);
		text-decoration: none;
		background-image: linear-gradient(to right, var(--color-accent), var(--color-accent));
		background-repeat: no-repeat;
		background-size: 0% 1px;
		background-position: left bottom -0.05em;
		transition:
			background-size 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
			color 200ms ease;
	}
	.wr-entry-title a:hover {
		color: var(--color-accent);
		background-size: 100% 1px;
	}
	.wr-entry-draft {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 600;
		margin-right: 0.4rem;
	}
	.wr-entry-desc {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0.6rem 0 0;
		font-variation-settings: "opsz" 16, "SOFT" 60;
		max-width: 60ch;
	}

	/* ============================================================
	   TAG LIST — small mono caps badges, no boxes
	   ============================================================ */
	.wr-tag-list {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.5rem;
	}
	.wr-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-global-text);
		text-decoration: none;
		padding: 0.3rem 0;
		border-bottom: 1px solid transparent;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}
	.wr-tag:hover {
		color: var(--color-accent);
		border-bottom-color: var(--color-accent);
	}

	.wr-tags-all {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent-2);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 0.4rem;
		transition:
			color 200ms ease,
			padding-left 250ms ease;
	}
	.wr-tags-all:hover {
		color: var(--color-accent);
		padding-left: 0.4rem;
	}
</style>
