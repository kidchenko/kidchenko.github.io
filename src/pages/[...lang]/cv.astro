---
import PageLayout from "@/layouts/Base.astro";
import { type Lang, languages } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang: lang === "en" ? undefined : lang },
		props: { lang: lang as Lang },
	}));
}

const { lang } = Astro.props;
const t = useTranslations(lang).cv;
const meta = { title: t.meta.title, description: t.meta.description };

const isPt = lang === "pt";
const ui = isPt
	? {
			chapterEyebrow: "IV — Folha de Bordo",
			fullRecordLabel: "Para o registro completo",
		}
	: {
			chapterEyebrow: "IV — Service Record",
			fullRecordLabel: "For the full record",
		};
---

<PageLayout meta={meta}>
	{/* ─── Chapter title ────────────────────────────────────────── */}
	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">{ui.chapterEyebrow}</p>
		<h1 class="lb-chapter-heading">{t.heading}</h1>
		<p class="lb-chapter-lead">{t.lead}</p>
	</header>

	{/* ─── Work history ─────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<h2 class="lb-section-heading">{t.workHeading}</h2>
		</header>
		<ol class="cv-list">
			{
				t.work.map((job) => (
					<li class="cv-entry">
						<div class="cv-entry-meta">
							<span class="cv-entry-period">{job.period}</span>
							<span class="cv-entry-location">
								{job.location}
								{"locationNote" in job && job.locationNote ? (
									<span class="cv-entry-location-note">{job.locationNote}</span>
								) : null}
							</span>
						</div>
						<div class="cv-entry-body">
							<h3 class="cv-entry-title">{job.title}</h3>
							{"role" in job && job.role ? <p class="cv-entry-role">{job.role}</p> : null}
							<div class="cv-entry-prose lb-prose">
								{job.body.map((p) => (
									<p set:html={p} />
								))}
							</div>
							<p class="cv-entry-stack">{job.stack}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	{/* ─── Education ────────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<h2 class="lb-section-heading">{t.eduHeading}</h2>
		</header>
		<ol class="cv-list">
			{
				t.edu.map((item) => (
					<li class="cv-entry cv-entry--compact">
						<div class="cv-entry-meta">
							<span class="cv-entry-period">{item.period}</span>
						</div>
						<div class="cv-entry-body">
							<h3 class="cv-entry-title cv-entry-title--small">{item.title}</h3>
							<p class="cv-entry-role">{item.role}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	{/* ─── Skills ───────────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<h2 class="lb-section-heading">{t.skillsHeading}</h2>
		</header>
		<ul class="cv-skills-list" role="list">
			{
				t.skills.map((skill) => (
					<li class="cv-skill">
						<h3 class="cv-skill-label">{skill.label}</h3>
						<p class="cv-skill-body">{skill.body}</p>
					</li>
				))
			}
		</ul>
	</section>

	{/* ─── Continuous learning ──────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<h2 class="lb-section-heading">{t.learning.label}</h2>
		</header>
		<p class="lb-prose" set:html={t.learning.body} />
	</section>

	{/* ─── Community & speaking ─────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<h2 class="lb-section-heading">{t.community.label}</h2>
		</header>
		<p class="lb-prose" set:html={t.community.body} />
	</section>

	{/* ─── Languages ────────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<h2 class="lb-section-heading">{t.languages.label}</h2>
		</header>
		<p class="lb-prose">{t.languages.body}</p>
	</section>

	{/* ─── For the full record (LinkedIn) ───────────────────────── */}
	<section class="cv-footer">
		<p class="cv-footer-label">{ui.fullRecordLabel}</p>
		<a class="cv-footer-link" href="https://linkedin.com/in/kidchenko" rel="noreferrer" target="_blank">
			linkedin.com/in/kidchenko <span aria-hidden="true">→</span>
		</a>
	</section>
</PageLayout>

<style>
	/* Page-specific styles. Shared chrome (lb-chapter, lb-section,
	   lb-prose) lives in global.css. */

	/* ============================================================
	   ENTRY LIST — work history & education.
	   Single-column rows: meta strip (period + location) sits on top,
	   then title / role / body / stack stack below at full width.
	   ============================================================ */
	.cv-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.cv-entry {
		padding: 2.25rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.cv-entry--compact {
		padding: 1.25rem 0;
	}

	.cv-entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 1.5rem;
		margin-bottom: 1.1rem;
	}
	.cv-entry-period {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 700;
	}
	.cv-entry-location {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
		font-weight: 500;
	}
	.cv-entry-location-note {
		font-size: 0.625rem;
		opacity: 0.75;
		margin-left: 0.4rem;
	}

	.cv-entry-title {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 1.5vw + 0.85rem, 1.875rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-global-text);
		margin: 0 0 0.4rem;
		font-variation-settings: "opsz" 48, "SOFT" 30, "WONK" 0;
	}
	.cv-entry-title--small {
		font-size: clamp(1.125rem, 0.6vw + 0.85rem, 1.25rem);
	}
	.cv-entry-role {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0 0 1.25rem;
		font-weight: 500;
	}
	.cv-entry-prose {
		font-size: 1rem;
		line-height: 1.65;
		max-width: 65ch;
	}
	.cv-entry-prose :global(p) {
		margin: 0 0 1rem;
	}
	.cv-entry-prose :global(p:last-child) {
		margin-bottom: 0;
	}
	.cv-entry-stack {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 1.25rem 0 0;
		font-weight: 500;
	}

	.cv-entry--compact .cv-entry-role {
		margin-bottom: 0;
	}

	/* ============================================================
	   SKILLS — same single-column shape: label as eyebrow, body below
	   ============================================================ */
	.cv-skills-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.cv-skill {
		padding: 1.5rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.cv-skill-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 0.6rem;
	}
	.cv-skill-body {
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-global-text);
		margin: 0;
		font-variation-settings: "opsz" 16;
		max-width: 65ch;
	}

	/* ============================================================
	   FULL-RECORD FOOTER — LinkedIn link, end-of-document mark
	   ============================================================ */
	.cv-footer {
		margin: 5rem 0 0;
		padding-top: 4rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}
	.cv-footer-label {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0;
		font-weight: 500;
	}
	.cv-footer-link {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent-2);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 0.4rem;
		transition:
			color 200ms ease,
			border-color 200ms ease,
			padding-left 250ms ease;
	}
	.cv-footer-link:hover {
		color: var(--color-accent);
		padding-left: 0.4rem;
	}
</style>

<style is:global>
	/* If someone hits Cmd+P, hide nav/footer chrome and let the page
	   print as-is — the LOGBOOK service record is the artifact. */
	@media print {
		#main-header,
		body > footer {
			display: none !important;
		}
		body {
			padding-top: 0 !important;
			max-width: none !important;
		}
	}
</style>
