---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import cafeIconUrl from "@/assets/img/apps/cafe-icon.png?url";
import cantosIconUrl from "@/assets/img/apps/cantos-icon.svg?url";
import cotaIconUrl from "@/assets/img/apps/cota-icon.svg?url";
import dotnetSaasBilling from "@/assets/img/apps/dotnet-saas-billing.png";
import dotnetSaasIconUrl from "@/assets/img/apps/dotnet-saas-icon.svg?url";
import luzIconUrl from "@/assets/img/apps/luz-icon.png?url";
import portaIconUrl from "@/assets/img/apps/porta-icon.png?url";
import sonusIconUrl from "@/assets/img/apps/sonus-icon.png?url";
import suavezIconUrl from "@/assets/img/apps/suavez-icon.png?url";
import veraIconUrl from "@/assets/img/apps/vera-icon.svg?url";
import veraInbox from "@/assets/img/apps/vera-inbox.png";
import { type Lang, languages } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang: lang === "en" ? undefined : lang },
		props: { lang: lang as Lang },
	}));
}

const { lang } = Astro.props;
const t = useTranslations(lang).portfolio;
const meta = {
	title: t.meta.title,
	description: t.meta.description,
	ogImage: "/og-image/portfolio.png",
};

const isPt = lang === "pt";
const ui = isPt ? { chapterEyebrow: "III · Travessias" } : { chapterEyebrow: "III · Voyages" };

type AppItem = (typeof t.apps.items)[number] & {
	href?: string;
	imageAlt?: string;
	iconAlt?: string;
};

const icons: Record<string, string> = {
	cafe: cafeIconUrl,
	cantos: cantosIconUrl,
	cota: cotaIconUrl,
	luz: luzIconUrl,
	porta: portaIconUrl,
	sonus: sonusIconUrl,
	suavez: suavezIconUrl,
	vera: veraIconUrl,
	"dotnet-saas": dotnetSaasIconUrl,
};
const shots: Record<string, ImageMetadata> = {
	vera: veraInbox,
	"dotnet-saas": dotnetSaasBilling,
};

const appItems: AppItem[] = [...t.apps.items];
const desktopApps = appItems.filter((item) => item.kind === "App");
const saasApps = appItems.filter((item) => item.kind === "SaaS");
---

<PageLayout meta={meta}>
	{/* ─── Chapter title ────────────────────────────────────────── */}
	<header class="lb-chapter">
		<p class="lb-chapter-eyebrow">{ui.chapterEyebrow}</p>
		<h1 class="lb-chapter-heading">{t.heading}</h1>
		<p class="lb-chapter-lead">{t.lead}</p>
	</header>

	{/* ─── i. Apps ──────────────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">i</p>
			<h2 class="lb-section-heading">{t.apps.heading}</h2>
		</header>
		<p class="lb-prose ap-lead">{t.apps.lead}</p>

		<h3 class="ap-group">{t.apps.groups.desktop}</h3>
		<ul class="ap-grid">
			{
				desktopApps.map((item) => (
					<li class="ap-card" id={item.slug}>
						<div class="ap-card-head">
							<img
								alt={item.iconAlt ?? ""}
								class="ap-icon"
								height="40"
								loading="lazy"
								src={icons[item.slug]}
								width="40"
							/>
							<div>
								<h4 class="ap-title">{item.title}</h4>
								<p class="ap-subtitle">{item.subtitle}</p>
							</div>
						</div>
						<p class="ap-body">{item.body}</p>
						<div class="ap-meta">
							<p class="ap-stack">{item.stack}</p>
							{item.href ? (
								<a class="ap-visit" href={item.href} rel="noreferrer" target="_blank">
									{t.apps.visit}
									<span class="sr-only"> {item.title}</span>
								</a>
							) : null}
						</div>
					</li>
				))
			}
		</ul>

		<h3 class="ap-group">{t.apps.groups.saas}</h3>
		<ul class="ap-grid ap-grid--saas">
			{
				saasApps.map((item) => {
					const shot = shots[item.slug];
					return (
						<li class="ap-card" id={item.slug}>
							{shot ? (
								<figure class="ap-shot">
									<Image
										alt={item.imageAlt ?? ""}
										class="ap-shot-img"
										sizes="(min-width: 640px) 22rem, 100vw"
										src={shot}
										widths={[360, 720, 1080]}
									/>
								</figure>
							) : null}
							<div class="ap-card-head">
								<img
									alt={item.iconAlt ?? ""}
									class="ap-icon"
									height="40"
									loading="lazy"
									src={icons[item.slug]}
									width="40"
								/>
								<div>
									<h4 class="ap-title">{item.title}</h4>
									<p class="ap-subtitle">{item.subtitle}</p>
								</div>
							</div>
							<p class="ap-body">{item.body}</p>
							<div class="ap-meta">
								<p class="ap-stack">{item.stack}</p>
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>

	{/* ─── ii. Past ventures ────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">ii</p>
			<h2 class="lb-section-heading">{t.past.heading}</h2>
		</header>

		<ol class="pf-past-list">
			{
				t.past.items.map((item) => (
					<li class="pf-past-entry">
						<span class="pf-past-period">{item.period}</span>
						<div class="pf-past-body-block">
							<h3 class="pf-past-title">{item.title}</h3>
							<p class="pf-past-subtitle">{item.subtitle}</p>
							<p class="pf-past-body">{item.body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	{/* ─── iii. Open source ─────────────────────────────────────── */}
	<section class="lb-section">
		<header class="lb-section-head">
			<p class="lb-section-eyebrow">iii</p>
			<h2 class="lb-section-heading">{t.oss.heading}</h2>
		</header>
		<p class="lb-prose">{t.oss.body}</p>
		<a class="pf-oss-link" href="https://github.com/kidchenko" rel="noreferrer" target="_blank">
			{t.oss.link}
		</a>
	</section>
</PageLayout>

<style>
	/* Page-specific styles only. Shared chrome (chapter title, sections,
	   prose, full-bleed) lives in global.css under .lb-*. */

	/* ============================================================
	   APPS
	   Two groups, each a hairline-ruled two-column grid: compact
	   tray-app entries, then the SaaS pair with screenshots.
	   ============================================================ */
	.ap-lead {
		margin: -0.75rem 0 2.5rem;
	}
	.ap-group {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 700;
		margin: 0 0 1rem;
	}
	.ap-grid {
		list-style: none;
		margin: 0 0 3rem;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		column-gap: 2.5rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
	}
	.ap-grid:last-child {
		margin-bottom: 0;
	}
	@media (min-width: 640px) {
		.ap-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	.ap-card {
		display: flex;
		flex-direction: column;
		padding: 1.5rem 0 1.75rem;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		scroll-margin-top: 5rem;
	}
	.ap-card-head {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		gap: 0.9rem;
		align-items: start;
	}
	.ap-icon {
		display: block;
		width: 2.5rem;
		height: 2.5rem;
	}
	.ap-title {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--color-global-text);
		margin: 0;
		font-variation-settings:
			"opsz" 36,
			"SOFT" 30,
			"WONK" 0;
	}
	.ap-subtitle {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
		line-height: 1.35;
		color: var(--color-global-text);
		margin: 0.3rem 0 0;
		font-variation-settings:
			"opsz" 18,
			"SOFT" 60;
		text-wrap: pretty;
	}
	.ap-body {
		font-family: var(--font-serif);
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--color-global-text);
		margin: 0.9rem 0 0;
		font-variation-settings: "opsz" 14;
		text-wrap: pretty;
	}
	.ap-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-top: auto;
		padding-top: 1rem;
	}
	.ap-stack {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0;
		font-weight: 500;
	}
	.ap-visit {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent-2);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 0.15rem;
		transition:
			color 200ms ease,
			border-color 200ms ease,
			padding-left 250ms ease;
	}
	.ap-visit:hover {
		color: var(--color-accent);
		padding-left: 0.4rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.ap-visit {
			transition: none;
		}
		.ap-visit:hover {
			padding-left: 0;
		}
	}
	.ap-shot {
		margin: 0 0 1.25rem;
	}
	.ap-shot-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: top left;
		border: 1px solid color-mix(in oklab, var(--color-global-text) 14%, transparent);
	}

	/* ============================================================
	   PAST VENTURES
	   Compact chronological list — period in the gutter, body right.
	   ============================================================ */
	.pf-past-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.pf-past-entry {
		padding: 1.75rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}
	@media (min-width: 880px) {
		.pf-past-entry {
			grid-template-columns: 12rem 1fr;
			gap: 4rem;
			align-items: baseline;
		}
	}
	.pf-past-period {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 600;
		padding-top: 0.4rem;
	}
	.pf-past-title {
		font-family: var(--font-display);
		font-size: clamp(1.375rem, 1.2vw + 0.85rem, 1.625rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-global-text);
		margin: 0;
		font-variation-settings: "opsz" 30, "SOFT" 30;
	}
	.pf-past-subtitle {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0.4rem 0 0.85rem;
		font-weight: 500;
	}
	.pf-past-body {
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-global-text);
		margin: 0;
		font-variation-settings: "opsz" 16;
		max-width: 60ch;
	}

	/* ============================================================
	   OPEN SOURCE — outbound link styled as a brass-underlined badge
	   ============================================================ */
	.pf-oss-link {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent-2);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 0.4rem;
		margin-top: 2rem;
		transition:
			color 200ms ease,
			border-color 200ms ease,
			padding-left 250ms ease;
	}
	.pf-oss-link:hover {
		color: var(--color-accent);
		padding-left: 0.4rem;
	}
</style>
