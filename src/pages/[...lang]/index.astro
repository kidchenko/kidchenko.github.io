---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import portrait from "@/assets/img/jose-headshot.png";
import { type Lang, languages } from "@/i18n/ui";
import { localizeUrl, useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang: lang === "en" ? undefined : lang },
		props: { lang: lang as Lang },
	}));
}

const { lang } = Astro.props;
const t = useTranslations(lang).home;
const tNav = useTranslations(lang).nav;

const allPosts = (await getAllPosts()).sort(collectionDateSort) as CollectionEntry<"post">[];
const featuredPost = allPosts.find((p) => p.data.pinned) ?? null;

const isPt = lang === "pt";

// Maritime chapter index — design vocabulary, lightly localised.
// Folios are real-world coordinates of cities tied to each chapter:
// Home → São Paulo, About → Recife, Portfolio → Chiang Mai,
// CV → Bangkok, Writing → St. Petersburg, Contact → Shanghai.
const chapterCoords = [
	"23°33′S 46°38′W",
	"8°03′S 34°53′W",
	"18°47′N 98°59′E",
	"13°45′N 100°30′E",
	"59°56′N 30°19′E",
	"31°14′N 121°28′E",
];

const chapters = isPt
	? [
			{ roman: "I", title: "Saudação", sub: tNav.home, path: localizeUrl("/", lang), folio: chapterCoords[0] },
			{
				roman: "II",
				title: "Capitão",
				sub: tNav.about,
				path: localizeUrl("/about/", lang),
				folio: chapterCoords[1],
			},
			{
				roman: "III",
				title: "Travessias",
				sub: tNav.portfolio,
				path: localizeUrl("/portfolio/", lang),
				folio: chapterCoords[2],
			},
			{
				roman: "IV",
				title: "Folha de Bordo",
				sub: tNav.cv,
				path: localizeUrl("/cv/", lang),
				folio: chapterCoords[3],
			},
			{
				roman: "V",
				title: "Diário",
				sub: tNav.writing,
				path: localizeUrl("/posts/", lang),
				folio: chapterCoords[4],
			},
			{
				roman: "VI",
				title: "Correspondência",
				sub: tNav.contact,
				path: localizeUrl("/contact/", lang),
				folio: chapterCoords[5],
			},
		]
	: [
			{ roman: "I", title: "Hailing", sub: tNav.home, path: localizeUrl("/", lang), folio: chapterCoords[0] },
			{
				roman: "II",
				title: "Captain",
				sub: tNav.about,
				path: localizeUrl("/about/", lang),
				folio: chapterCoords[1],
			},
			{
				roman: "III",
				title: "Voyages",
				sub: tNav.portfolio,
				path: localizeUrl("/portfolio/", lang),
				folio: chapterCoords[2],
			},
			{
				roman: "IV",
				title: "Service Record",
				sub: tNav.cv,
				path: localizeUrl("/cv/", lang),
				folio: chapterCoords[3],
			},
			{
				roman: "V",
				title: "Logbook",
				sub: tNav.writing,
				path: localizeUrl("/posts/", lang),
				folio: chapterCoords[4],
			},
			{
				roman: "VI",
				title: "Correspondence",
				sub: tNav.contact,
				path: localizeUrl("/contact/", lang),
				folio: chapterCoords[5],
			},
		];

const ui = isPt
	? {
			heroRunHead: "Atlas pessoal",
			heroVol: "Volume MMXXVI",
			heroCoords: "23°33′S  46°38′W — São Paulo, MMXXVI",
			heroStandfirst:
				"Quinze anos navegando times de engenharia entre a Tailândia e o Brasil. Hoje, fundando produtos de IA e ensinando organizações a usá-los bem.",
			plateLabel: "O Capitão",
			plateCaption: "São Paulo, Maio MMXXVI",
			scrollCue: "Rumo 180° — Sumário",
			indexEyebrow: "Sumário",
			indexHeading: "Volume MMXXVI, em seis capítulos.",
			indexSubheading: "Índice geral. Cada capítulo abre uma porção do trabalho.",
			soundingsEyebrow: "Sondagens",
			soundingsHeading: t.outcomesHeading,
			fathomsLabel: "braças",
			logbookEyebrow: "Do diário",
			logbookHeading: t.featuredHeading,
			hailingEyebrow: "Sinal",
			hailingStatement:
				"Disponível para posições de liderança em engenharia, treinamentos de IA e consultoria.",
			hailingLink: "Enviar uma mensagem",
		}
	: {
			heroRunHead: "Personal Atlas",
			heroVol: "Volume MMXXVI",
			heroCoords: "23°33′S  46°38′W — São Paulo, MMXXVI",
			heroStandfirst:
				"Fifteen years steering engineering teams between Thailand and Brazil. Now founding AI products and teaching organisations to use them well.",
			plateLabel: "The Captain",
			plateCaption: "São Paulo, May MMXXVI",
			scrollCue: "Bearing 180° — Contents",
			indexEyebrow: "Contents",
			indexHeading: "Volume MMXXVI, in six chapters.",
			indexSubheading: "General index. Each chapter opens a portion of the work.",
			soundingsEyebrow: "Soundings",
			soundingsHeading: t.outcomesHeading,
			fathomsLabel: "fathoms",
			logbookEyebrow: "From the logbook",
			logbookHeading: t.featuredHeading,
			hailingEyebrow: "Hailing",
			hailingStatement:
				"Available for engineering leadership roles, AI training, and consulting engagements.",
			hailingLink: "Send a message",
		};

const contactUrl = localizeUrl("/contact/", lang);
---

<PageLayout meta={{ title: t.meta.title }} wide>
	{/* ─── HERO / FRONTISPIECE ────────────────────────────────────── */}
	<section class="lb-fullbleed logbook-hero" aria-labelledby="frontispiece">
		<div class="logbook-running-head">
			<span class="rh-left">{ui.heroRunHead}</span>
			<span class="rh-right">{ui.heroVol}</span>
		</div>

		<p class="logbook-coords logbook-coords-mobile">{ui.heroCoords}</p>

		<div class="logbook-hero-grid">
			<div class="logbook-title-block">
				<p class="logbook-coords logbook-coords-desktop">{ui.heroCoords}</p>
				<h1 class="logbook-title" id="frontispiece">
					<span class="logbook-title-line">Jose</span>
					<span class="logbook-title-line is-italic">Barbosa</span>
				</h1>
				<div aria-hidden="true" class="logbook-rule"></div>
				<p class="logbook-role">{t.heroRole}</p>
				<p class="logbook-standfirst">{ui.heroStandfirst}</p>
			</div>

			<figure class="logbook-plate">
				<p class="plate-label">{ui.plateLabel}</p>
				<div class="plate-figure">
					<div aria-hidden="true" class="plate-glow"></div>
					<Image
						alt="Portrait of Jose Barbosa"
						class="plate-photo"
						format="webp"
						loading="eager"
						sizes="(min-width: 880px) 46vw, 100vw"
						src={portrait}
						widths={[640, 1024, 1600]}
					/>
				</div>
				<figcaption class="plate-caption">{ui.plateCaption}</figcaption>
			</figure>
		</div>

		<a class="logbook-bearing" href="#contents">
			<span aria-hidden="true" class="bearing-arrow">↓</span>
			<span>{ui.scrollCue}</span>
		</a>
	</section>

	{/* ─── INDEX / TABLE OF CONTENTS ──────────────────────────────── */}
	<section class="logbook-section lb-fullbleed">
		<div class="logbook-section-inner">
			<header class="logbook-section-head" id="contents">
				<p class="section-eyebrow">{ui.indexEyebrow}</p>
				<h2 class="section-heading">{ui.indexHeading}</h2>
				<p class="section-sub">{ui.indexSubheading}</p>
			</header>

			<ol class="contents-list" role="list">
				{
					chapters.map((ch) => (
						<li class="contents-row">
							<a class="contents-link" href={ch.path}>
								<span class="contents-roman">{ch.roman}</span>
								<span class="contents-title">{ch.title}</span>
								<span class="contents-sub">{ch.sub}</span>
								<span class="contents-folio">{ch.folio}</span>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* ─── SOUNDINGS ─────────────────────────────────────────────── */}
	<section class="logbook-section lb-fullbleed">
		<div class="logbook-section-inner">
			<header class="logbook-section-head">
				<p class="section-eyebrow">{ui.soundingsEyebrow}</p>
				<h2 class="section-heading">{ui.soundingsHeading}</h2>
			</header>

			<div class="soundings-list">
				{
					t.outcomes.map((o, i) => {
						const [num = "", label = ""] = o.eyebrow.split(" / ");
						const depth = (i + 1) * 17 + 23;
						return (
							<article class="sounding">
								<div class="sounding-meta">
									<span class="sounding-no">No. {num.padStart(2, "0")}</span>
									<span class="sounding-label">{label}</span>
									<span class="sounding-bearing">
										{depth} {ui.fathomsLabel}
									</span>
								</div>
								<div class="sounding-body-block">
									<h3 class="sounding-heading">{o.heading}</h3>
									<p class="sounding-body" set:html={o.body} />
								</div>
							</article>
						);
					})
				}
			</div>
		</div>
	</section>

	{/* ─── FROM THE LOGBOOK (featured writing) ───────────────────── */}
	{
		featuredPost && (
			<section class="logbook-section lb-fullbleed">
				<div class="logbook-section-inner">
					<header class="logbook-section-head">
						<p class="section-eyebrow">{ui.logbookEyebrow}</p>
						<h2 class="section-heading">{ui.logbookHeading}</h2>
					</header>
					<ul class="lb-entry-list" role="list">
						<li class="lb-entry">
							<PostPreview as="h3" post={featuredPost} />
						</li>
					</ul>
				</div>
			</section>
		)
	}

	{/* ─── HAILING / CTA ────────────────────────────────────────── */}
	<section class="logbook-section lb-fullbleed hailing-section">
		<div class="logbook-section-inner hailing-inner">
			<p class="section-eyebrow">{ui.hailingEyebrow}</p>
			<p class="hailing-statement">{ui.hailingStatement}</p>
			<a class="hailing-link" href={contactUrl}>
				<span class="hailing-link-label">{ui.hailingLink}</span>
				<span aria-hidden="true" class="hailing-link-arrow">→</span>
			</a>
		</div>
	</section>
</PageLayout>

<style>
	/* Page-specific: hero composition + chart-style sections.
	   The shared chrome (palette, fullbleed utility, lb-* primitives)
	   lives in global.css. Home declares its own section vocabulary
	   because the chapter-title page uses a different rhythm than
	   inner pages — running-head bar, contents list, soundings,
	   featured logbook entry, colophon. */

	/* ============================================================
	   HERO / FRONTISPIECE
	   ============================================================ */
	.logbook-hero {
		position: relative;
		min-height: 100svh;
		max-height: 100svh;
		padding: 1rem 1.25rem 6.5rem;
		display: flex;
		flex-direction: column;
		overflow: visible;
	}

	/* running head — top-of-page chart bar */
	.logbook-running-head {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1rem;
		align-items: baseline;
		padding-block: 0.6rem;
		border-top: 1px solid var(--color-global-text);
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 22%, transparent);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-top: 3.75rem;
	}
	.logbook-running-head .rh-right {
		text-align: right;
	}
	.logbook-running-head .rh-left {
		color: var(--color-accent);
		font-weight: 600;
	}

	.logbook-hero-grid {
		flex: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: center;
		padding-top: 2.5rem;
	}

	/* title block */
	.logbook-coords {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 1.5rem;
		font-weight: 600;
	}
	.logbook-title {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(3.5rem, 9.5vw, 8.25rem);
		line-height: 0.9;
		letter-spacing: -0.045em;
		color: var(--color-global-text);
		margin: 0;
		font-variation-settings:
			"opsz" 144,
			"SOFT" 30,
			"WONK" 0;
	}
	.logbook-title-line {
		display: block;
		font-variation-settings:
			"opsz" 144,
			"SOFT" 30,
			"WONK" 0;
	}
	.logbook-title-line.is-italic {
		font-style: italic;
		font-variation-settings:
			"opsz" 144,
			"SOFT" 70,
			"WONK" 1;
		color: var(--color-accent);
	}

	.logbook-rule {
		width: 5.5rem;
		height: 1px;
		background: var(--color-accent);
		margin: 1.25rem 0 1rem;
		transform-origin: left center;
	}
	.logbook-role {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--color-global-text);
		margin: 0 0 1rem;
		font-weight: 500;
	}
	.logbook-standfirst {
		font-family: var(--font-display);
		font-weight: 400;
		font-style: italic;
		font-size: clamp(1.0625rem, 1.4vw + 0.4rem, 1.4rem);
		line-height: 1.45;
		color: var(--color-global-text);
		max-width: 32ch;
		margin: 0;
		font-variation-settings:
			"opsz" 18,
			"SOFT" 60,
			"WONK" 0;
		text-wrap: balance;
	}

	/* portrait plate — no frame; the cutout sits on the page so it
	   blends naturally. A soft brass halo behind gives weight, and the
	   very bottom edge feathers into the bg. */
	.logbook-plate {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.plate-label {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0;
	}
	.plate-figure {
		position: relative;
		aspect-ratio: 4 / 5;
		max-height: calc(100svh - 12rem);
		margin-inline: auto;
		isolation: isolate;
	}
	.plate-glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: radial-gradient(
			ellipse 70% 55% at 50% 65%,
			color-mix(in oklab, var(--color-accent) 16%, transparent) 0%,
			transparent 72%
		);
		filter: blur(36px);
		opacity: 0.9;
	}
	.plate-photo {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 92%,
			rgba(0, 0, 0, 0) 100%
		);
		-webkit-mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 92%,
			rgba(0, 0, 0, 0) 100%
		);
	}

	.plate-caption {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	/* bearing scroll cue */
	.logbook-bearing {
		position: absolute;
		left: 1.25rem;
		bottom: 1.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-muted);
		text-decoration: none;
		transition: color 200ms ease;
	}
	.logbook-bearing:hover {
		color: var(--color-accent);
	}
	.bearing-arrow {
		display: inline-block;
		animation: bearing-bob 2.4s ease-in-out infinite;
	}
	@keyframes bearing-bob {
		0%,
		100% {
			transform: translateY(0);
			opacity: 0.7;
		}
		50% {
			transform: translateY(3px);
			opacity: 1;
		}
	}

	@media (min-width: 880px) {
		.logbook-hero {
			padding: 1.25rem 3rem 1.5rem;
		}
		.logbook-running-head {
			margin-top: 4.5rem;
		}
		.logbook-hero-grid {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			gap: 4rem;
			padding-top: 0;
			align-items: center;
		}
		.plate-figure {
			aspect-ratio: 1 / 1.08;
			max-height: none;
			flex: 0 0 auto;
			align-self: center;
			width: auto;
			height: calc(100svh - 7rem);
			margin-inline: auto;
			margin-top: -2.5rem;
			min-height: 0;
		}
		.plate-photo {
			object-position: center top;
		}
		.plate-label,
		.plate-caption {
			display: none;
		}
		.logbook-bearing {
			left: 3rem;
			bottom: 1.75rem;
		}
	}
	@media (min-width: 1280px) {
		.logbook-hero {
			padding: 1.5rem 5rem 1.25rem;
		}
		.logbook-running-head {
			margin-top: 4.5rem;
		}
		.logbook-hero-grid {
			gap: 5.5rem;
		}
		.logbook-bearing {
			left: 5rem;
			bottom: 2.25rem;
		}
	}

	/* Coords default: the standalone mobile copy is hidden on desktop.
	   The mobile media query below flips this so the standalone copy
	   renders above the picture and the in-title-block copy is hidden.
	   This rule must come BEFORE the mobile media query so the cascade
	   lets the media query override it. */
	.logbook-coords-mobile {
		display: none;
	}

	/* ============================================================
	   MOBILE — picture as background with title overlay
	   Picture goes full-bleed at the top of the grid, title-block
	   pulled up via negative margin so its content overlaps the
	   faded portion of the picture.
	   ============================================================ */
	@media (max-width: 879px) {
		.logbook-hero {
			padding-bottom: 5.5rem;
		}
		.logbook-running-head {
			display: none;
		}
		.logbook-hero-grid {
			grid-template-columns: 1fr;
			gap: 0;
			padding-top: 1rem;
			align-items: start;
		}
		.logbook-plate {
			order: -1;
			margin: 0 -1.25rem;
			z-index: 0;
			pointer-events: none;
		}
		.plate-figure {
			aspect-ratio: 4 / 5;
			max-height: 60svh;
			width: 100%;
			margin-inline: 0;
		}
		.plate-photo {
			object-position: center top;
			mask-image: linear-gradient(
				to bottom,
				rgba(0, 0, 0, 1) 0%,
				rgba(0, 0, 0, 1) 42%,
				rgba(0, 0, 0, 0.5) 65%,
				rgba(0, 0, 0, 0.15) 85%,
				rgba(0, 0, 0, 0) 100%
			);
			-webkit-mask-image: linear-gradient(
				to bottom,
				rgba(0, 0, 0, 1) 0%,
				rgba(0, 0, 0, 1) 42%,
				rgba(0, 0, 0, 0.5) 65%,
				rgba(0, 0, 0, 0.15) 85%,
				rgba(0, 0, 0, 0) 100%
			);
		}
		.logbook-title-block {
			margin-top: -30svh;
			position: relative;
			z-index: 1;
		}
		.logbook-coords-desktop {
			display: none;
		}
		.logbook-coords-mobile {
			display: block;
			margin: 4.5rem 0 0;
		}
		.plate-label,
		.plate-caption {
			display: none;
		}
		.logbook-bearing {
			bottom: 0.75rem;
		}
	}

	/* ============================================================
	   SHARED SECTION CHROME
	   ============================================================ */
	.logbook-section {
		padding: 5.5rem 1.25rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
	}
	.logbook-section-inner {
		max-width: 78rem;
		margin: 0 auto;
	}
	@media (min-width: 880px) {
		.logbook-section {
			padding: 8rem 3rem;
		}
	}
	@media (min-width: 1280px) {
		.logbook-section {
			padding: 10rem 5rem;
		}
	}

	.logbook-section-head {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin-bottom: 4rem;
	}
	.section-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0;
		font-weight: 600;
	}
	.section-heading {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2rem, 4vw + 0.5rem, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.025em;
		color: var(--color-global-text);
		margin: 0.5rem 0 0;
		font-variation-settings:
			"opsz" 72,
			"SOFT" 30,
			"WONK" 0;
		max-width: 24ch;
		text-wrap: balance;
	}
	.section-sub {
