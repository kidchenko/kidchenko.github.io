---
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import headshot from "@/assets/img/jose-headshot.jpg";

const allPosts = (await getAllPosts()).sort(collectionDateSort) as CollectionEntry<"post">[];
const featuredPost = allPosts.find((p) => p.data.pinned) ?? null;
---

<PageLayout meta={{ title: "Jose Barbosa - Engineering Director" }}>
	<section class="hero-fullbleed relative h-screen overflow-hidden">
		<div class="absolute inset-0 sm:left-[48%]">
			<Image
				alt="Portrait of Jose Barbosa"
				class="h-full w-full object-cover object-[center_15%]"
				loading="eager"
				sizes="(min-width: 640px) 52vw, 100vw"
				src={headshot}
				widths={[640, 1024, 1600]}
			/>
			<div
				class="absolute inset-0 bg-gradient-to-t from-global-bg via-global-bg/85 to-global-bg/40 sm:hidden"
			>
			</div>
			<div
				class="absolute inset-y-0 left-0 hidden w-40 bg-gradient-to-r from-global-bg to-transparent sm:block"
			>
			</div>
		</div>

		<div
			class="relative flex h-full items-center px-6 sm:px-12 lg:px-20"
		>
			<div class="max-w-xl">
				<h1 class="title mb-4 text-5xl leading-[1.05] sm:text-6xl lg:text-7xl">Jose Barbosa</h1>
				<p class="text-accent mb-8 text-lg font-semibold sm:text-xl">
					Engineering Director - AI / SaaS / Team Building
				</p>
				<p class="text-base leading-relaxed sm:text-lg">
					15 years building engineering teams across <strong>Thailand and Brazil</strong>.
					Scaled Seven Peaks Software's engineering org from <strong
						>30 to 60 across 27 nationalities</strong
					>. Currently founding AI products and consulting from Brazil.
				</p>
			</div>
		</div>

		<a
			class="text-muted hover:text-accent absolute bottom-8 left-6 z-10 inline-flex items-center gap-2 text-xs font-semibold tracking-wider uppercase transition-colors sm:left-12 lg:left-20"
			href="#outcomes"
		>
			<span>Selected outcomes</span>
			<span aria-hidden="true" class="scroll-arrow">↓</span>
		</a>
	</section>

	<section class="mt-32" id="outcomes">
		<h2 class="title mb-12 text-xl">Selected outcomes</h2>

		<div class="divide-y divide-global-text/10 border-y border-global-text/10">
			<article class="py-10 sm:grid sm:grid-cols-[8rem_1fr] sm:gap-12 sm:py-14">
				<div
					class="text-accent mb-4 text-xs font-bold tracking-wider uppercase sm:mb-0"
				>
					01 / Scale
				</div>
				<div>
					<h3 class="mb-3 text-lg leading-snug font-bold sm:text-xl">
						Scaled an engineering org from 30 to 60.
					</h3>
					<p class="leading-relaxed">
						At Seven Peaks Software, promoted from Head of Backend to Head of Engineering
						within a year. Led 4 principals and 12 tech leads across 27 nationalities; owned
						<strong>$3M+ annual P&amp;L</strong>.
					</p>
				</div>
			</article>
			<article class="py-10 sm:grid sm:grid-cols-[8rem_1fr] sm:gap-12 sm:py-14">
				<div
					class="text-accent mb-4 text-xs font-bold tracking-wider uppercase sm:mb-0"
				>
					02 / Retention
				</div>
				<div>
					<h3 class="mb-3 text-lg leading-snug font-bold sm:text-xl">
						Built a team engineers stayed in - and grew in.
					</h3>
					<p class="leading-relaxed">
						Ran 1:1s at scale: bi-weekly with 12 direct reports plus quarterly 1:1s with
						every engineer in the department. Redesigned the interview process to filter for
						fit early. Created the Leader Development Program for tech leads. Quarterly
						attrition halved over the tenure.
					</p>
				</div>
			</article>
			<article class="py-10 sm:grid sm:grid-cols-[8rem_1fr] sm:gap-12 sm:py-14">
				<div
					class="text-accent mb-4 text-xs font-bold tracking-wider uppercase sm:mb-0"
				>
					03 / Revenue
				</div>
				<div>
					<h3 class="mb-3 text-lg leading-snug font-bold sm:text-xl">
						Turned engineering excellence into a revenue line.
					</h3>
					<p class="leading-relaxed">
						Bi-monthly technical workshops (DDD, OWASP, Performance, AI) evolved into a paid
						enterprise AI training program. Clients include EGAT. Now running enterprise AI
						training across APAC and Brazil.
					</p>
				</div>
			</article>
		</div>
	</section>

	{
		featuredPost && (
			<section class="mt-20">
				<h2 class="title mb-6 text-xl">
					<a href="/posts/">Featured writing</a>
				</h2>
				<div class="grid gap-1 sm:grid-cols-[auto_1fr]">
					<PostPreview post={featuredPost} />
				</div>
			</section>
		)
	}

	<section class="mt-20">
		<SocialList />
	</section>
</PageLayout>

<style>
	.hero-fullbleed {
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		width: 100vw;
	}
	.scroll-arrow {
		display: inline-block;
		animation: scroll-bounce 2s ease-in-out infinite;
	}
	@keyframes scroll-bounce {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(4px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.scroll-arrow {
			animation: none;
		}
	}
</style>

<style is:global>
	body {
		padding-top: 0 !important;
		--color-global-bg: oklch(98.48% 0 0);
		--color-global-text: oklch(26.99% 0.0096 235.05);
		--color-muted: oklch(44.6% 0.03 256.802);
		--color-link: oklch(55.44% 0.0431 185.69);
		--color-accent: oklch(55.27% 0.195 19.06);
		--color-accent-2: oklch(18.15% 0 0);
		--color-quote: oklch(55.27% 0.195 19.06);
		background-color: var(--color-global-bg);
		color: var(--color-global-text);
	}
	#main-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		margin-bottom: 0 !important;
		padding: 1rem 1.5rem;
	}
	#main-header theme-toggle {
		display: none;
	}
	@media (min-width: 640px) {
		#main-header {
			padding: 1.5rem 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		#main-header {
			padding: 1.75rem 3rem;
		}
	}
</style>
