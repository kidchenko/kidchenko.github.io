---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { getLangFromUrl } from "@/i18n/utils";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	wide?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	wide = false,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = lang === "pt" ? "pt-BR" : "en";
---

<html class="scroll-smooth" lang={htmlLang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text flex min-h-screen flex-col font-mono text-sm font-normal antialiased"
	>
		<SkipLink />
		<Header />
		<main
			class:list={["flex-1", { "mx-auto w-full max-w-3xl px-4 sm:px-8": !wide }]}
			id="main"
		>
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
