---
import { getAlternateUrl, getLangFromUrl, getOtherLang } from "@/i18n/utils";
import { languages } from "@/i18n/ui";

const currentLang = getLangFromUrl(Astro.url);
const otherLang = getOtherLang(currentLang);
const alternateUrl = getAlternateUrl(Astro.url.pathname, currentLang);
---

<a
	aria-label={`Switch language to ${languages[otherLang]}`}
	class="lang-toggle"
	href={alternateUrl}
	hreflang={otherLang}
>
	{otherLang.toUpperCase()}
</a>

<style>
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		padding: 0.35rem 0.6rem;
		color: var(--color-global-text);
		border: 1px solid color-mix(in oklab, var(--color-global-text) 22%, transparent);
		text-decoration: none;
		transition:
			color 150ms ease,
			border-color 150ms ease;
	}
	.lang-toggle:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
</style>
