---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { getLangFromUrl } from "@/i18n/utils";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
}

const {
	content: { data },
	readingTime,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const isPt = lang === "pt";

const dateOpts: Intl.DateTimeFormatOptions = {
	year: "numeric",
	month: "long",
	day: "numeric",
};

const ui = isPt
	? { chapterEyebrow: "V — Diário", draft: "Rascunho", updated: "Atualizado" }
	: { chapterEyebrow: "V — Logbook", draft: "Draft", updated: "Updated" };
---

{
	data.coverImage && (
		<figure class="lb-cover lb-fullbleed">
			<Image
				alt={data.coverImage.alt}
				class="lb-cover-img"
				height={900}
				priority
				src={data.coverImage.src}
				width={1600}
			/>
		</figure>
	)
}

<header class="lb-post-masthead">
	<p class="lb-chapter-eyebrow">{ui.chapterEyebrow}</p>
	{data.draft && <p class="lb-post-draft">({ui.draft})</p>}
	<h1 class="lb-post-title">{data.title}</h1>
	{data.description && <p class="lb-post-standfirst">{data.description}</p>}

	<div class="lb-post-meta">
		<FormattedDate class="lb-post-meta-date" date={data.publishDate} dateTimeOptions={dateOpts} />
		<span aria-hidden="true" class="lb-post-meta-sep">—</span>
		<span>{readingTime}</span>
		{
			data.updatedDate && (
				<>
					<span aria-hidden="true" class="lb-post-meta-sep">
						—
					</span>
					<span>
						{ui.updated}{" "}
						<FormattedDate date={data.updatedDate} dateTimeOptions={dateOpts} />
					</span>
				</>
			)
		}
	</div>

	{
		!!data.tags?.length && (
			<ul class="lb-post-tags" role="list">
				{data.tags.map((tag) => (
					<li>
						<a class="lb-post-tag" data-pagefind-filter={`tag:${tag}`} href={`/tags/${tag}/`}>
							<span aria-hidden="true">#</span>
							{tag}
						</a>
					</li>
				))}
			</ul>
		)
	}
</header>

<style>
	/* COVER — full-bleed band with feathered bottom edge, mirrors the
	   about-page frontispiece treatment. */
	.lb-cover {
		margin: 0 calc(50% - 50vw) 3rem;
		width: 100vw;
	}
	.lb-cover-img {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		display: block;
		mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 88%,
			rgba(0, 0, 0, 0.5) 96%,
			rgba(0, 0, 0, 0) 100%
		);
		-webkit-mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 1) 88%,
			rgba(0, 0, 0, 0.5) 96%,
			rgba(0, 0, 0, 0) 100%
		);
	}

	/* MASTHEAD */
	.lb-post-masthead {
		margin: 0 0 3rem;
	}
	.lb-post-draft {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 700;
		margin: 0 0 0.75rem;
	}
	.lb-post-title {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.25rem, 4vw + 1rem, 3.75rem);
		line-height: 1.05;
		letter-spacing: -0.025em;
		color: var(--color-global-text);
		margin: 0 0 1.5rem;
		font-variation-settings: "opsz" 96, "SOFT" 30, "WONK" 0;
		text-wrap: balance;
		max-width: 24ch;
	}
	.lb-post-standfirst {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.125rem, 0.8vw + 0.85rem, 1.375rem);
		line-height: 1.4;
		color: var(--color-global-text);
		margin: 0 0 2rem;
		max-width: 42ch;
		font-variation-settings: "opsz" 24, "SOFT" 60;
		text-wrap: pretty;
	}

	.lb-post-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0 0 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.75rem;
		align-items: center;
		font-weight: 500;
	}
	.lb-post-meta-date {
		color: var(--color-accent);
		font-weight: 600;
	}
	.lb-post-meta-sep {
		opacity: 0.4;
	}

	.lb-post-tags {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 1.25rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.lb-post-tag {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-global-text);
		text-decoration: none;
		font-weight: 500;
		transition: color 200ms ease;
	}
	.lb-post-tag:hover {
		color: var(--color-accent);
	}
</style>
