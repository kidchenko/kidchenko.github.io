---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	draftLabel?: string;
	withDesc?: boolean;
};

const {
	as: Tag = "h3",
	post,
	draftLabel = "(Draft) ",
	withDesc = true,
} = Astro.props;
---

<FormattedDate class="lb-entry-date" date={post.data.publishDate} />
<div class="lb-entry-body">
	<Tag class="lb-entry-title">
		{post.data.draft && <span class="lb-entry-draft">{draftLabel}</span>}
		<a href={`/posts/${post.id}/`}>{post.data.title}</a>
	</Tag>
	{
		withDesc && post.data.description && (
			<p class="lb-entry-desc">{post.data.description}</p>
		)
	}
</div>
