---
import LanguageToggle from "@/components/LanguageToggle.astro";
import { getLangFromUrl, localizeUrl, useTranslations } from "@/i18n/utils";
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).footer;
const tNav = useTranslations(lang).nav;
const navLinks: { path: string; title: string }[] = [
	{ path: localizeUrl("/", lang), title: tNav.home },
	{ path: localizeUrl("/about/", lang), title: tNav.about },
	{ path: localizeUrl("/portfolio/", lang), title: tNav.portfolio },
	{ path: localizeUrl("/posts/", lang), title: tNav.writing },
	{ path: localizeUrl("/cv/", lang), title: tNav.cv },
	{ path: localizeUrl("/contact/", lang), title: tNav.contact },
];
---

<footer class="lb-footer">
	<div class="lb-footer-inner">
		<div class="lb-footer-imprint">
			<p class="lb-footer-copyright">{siteConfig.author} {year}</p>
			<span class="lb-footer-imprint-lang"><LanguageToggle /></span>
		</div>
		<nav class="lb-footer-nav" aria-label={t.navigate}>
			{
				navLinks.map((link) => (
					<a class="lb-footer-link" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
		<nav class="lb-footer-elsewhere" aria-label={t.elsewhere}>
			<a
				class="lb-footer-link"
				href="https://github.com/kidchenko"
				rel="noreferrer me"
				target="_blank"
			>
				GitHub
			</a>
			<a
				class="lb-footer-link"
				href="https://linkedin.com/in/kidchenko"
				rel="noreferrer me"
				target="_blank"
			>
				LinkedIn
			</a>
			<a class="lb-footer-link" href="/rss.xml">{t.rss}</a>
			<span class="lb-footer-elsewhere-lang"><LanguageToggle /></span>
		</nav>
	</div>
</footer>

<style>
	.lb-footer {
		margin-top: 4rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
		color: var(--color-muted);
		font-family: var(--font-mono);
	}

	/* Inner wrapper spans the editorial column (78rem cap), with the same
	   horizontal padding as the header so the imprint mirrors the
	   running-head bar at the top of the page. */
	.lb-footer-inner {
		max-width: 78rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
		padding-top: 2rem;
		padding-bottom: 1.75rem;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
	}
	@media (min-width: 880px) {
		.lb-footer-inner {
			padding-inline: 3rem;
		}
	}
	@media (min-width: 1280px) {
		.lb-footer-inner {
			padding-inline: 5rem;
		}
	}

	.lb-footer-imprint {
		order: 3;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}
	.lb-footer-copyright {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-global-text);
	}
	.lb-footer-elsewhere-lang {
		display: none;
	}

	.lb-footer-nav {
		order: 1;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.9rem;
	}

	.lb-footer-elsewhere {
		order: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
	}

	.lb-footer-link {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		text-decoration: none;
		transition: color 200ms ease;
	}

	.lb-footer-link:hover {
		color: var(--color-accent);
	}

	@media (min-width: 640px) {
		.lb-footer {
			margin-top: 6rem;
		}
		.lb-footer-inner {
			padding-top: 2.5rem;
			padding-bottom: 2rem;
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 2rem;
		}
		.lb-footer-imprint {
			order: 0;
			display: contents;
		}
		.lb-footer-imprint-lang {
			display: none;
		}
		.lb-footer-elsewhere-lang {
			display: inline-flex;
		}
		.lb-footer-nav,
		.lb-footer-elsewhere {
			order: 0;
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 1.25rem;
			padding-top: 0;
			border-top: none;
		}
	}
</style>
