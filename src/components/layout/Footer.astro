---
import LanguageToggle from "@/components/LanguageToggle.astro";
import { getLangFromUrl, localizeUrl, useTranslations } from "@/i18n/utils";
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).nav;
const menuLinks: { path: string; title: string }[] = [
	{ path: localizeUrl("/", lang), title: t.home },
	{ path: localizeUrl("/about/", lang), title: t.about },
	{ path: localizeUrl("/portfolio/", lang), title: t.portfolio },
	{ path: localizeUrl("/posts/", lang), title: t.writing },
	{ path: localizeUrl("/cv/", lang), title: t.cv },
	{ path: localizeUrl("/contact/", lang), title: t.contact },
];
---

<footer
	class="text-muted mt-auto flex w-full flex-col items-center gap-y-4 pt-20 pb-6 text-center text-xs font-semibold sm:flex-row sm:items-center sm:justify-between sm:gap-y-0"
>
	<div>&copy; {siteConfig.author} {year}</div>
	<nav
		aria-labelledby="footer_links"
		class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1"
	>
		<p id="footer_links" class="sr-only">More on this site</p>
		{
			menuLinks.map((link) => (
				<a class="hover:text-global-text hover:underline" href={link.path}>
					{link.title}
				</a>
			))
		}
		<LanguageToggle />
	</nav>
</footer>
