---
import fs from "node:fs";
import path from "node:path";
import LanguageToggle from "@/components/LanguageToggle.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getLangFromUrl, localizeUrl, useTranslations } from "@/i18n/utils";

const markSvg = fs.readFileSync(
	path.resolve("./src/assets/img/logo/svg/mark.svg"),
	"utf-8",
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).nav;
const tCommon = useTranslations(lang).common;
const menuLinks: { path: string; title: string }[] = [
	{ path: localizeUrl("/", lang), title: t.home },
	{ path: localizeUrl("/about/", lang), title: t.about },
	{ path: localizeUrl("/portfolio/", lang), title: t.portfolio },
	{ path: localizeUrl("/posts/", lang), title: t.writing },
	{ path: localizeUrl("/cv/", lang), title: t.cv },
	{ path: localizeUrl("/contact/", lang), title: t.contact },
];
const romanNumerals = ["I", "II", "III", "IV", "V", "VI"];
---

<header class="lb-header group relative z-10 flex items-center" id="main-header">
	<a aria-current={false} aria-label="Jose Barbosa - home" class="logo-link" href={localizeUrl("/", lang)}>
		<span aria-hidden="true" class="logo-mark" set:html={markSvg} />
		<span class="logo-wordmark">Jose Barbosa</span>
	</a>
	<nav
		aria-label="Main menu"
		class="nav-menu bg-global-bg/95 fixed inset-x-0 top-0 z-40 hidden flex-col items-stretch overflow-y-auto px-8 pt-24 backdrop-blur-md group-[.menu-open]:flex sm:static sm:inset-auto sm:z-auto sm:ms-8 sm:flex sm:h-auto sm:flex-row sm:items-center sm:gap-0 sm:overflow-visible sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
		id="navigation-menu"
	>
		<div class="nav-list flex flex-1 flex-col sm:flex-row sm:gap-0">
			{
				menuLinks.map((link, i) => (
					<a
						aria-current={Astro.url.pathname === link.path ? "page" : false}
						class:list={[
							"nav-link",
							Astro.url.pathname === link.path ? "is-current" : "",
						]}
						href={link.path}
					>
						<span aria-hidden="true" class="nav-link-num">
							{romanNumerals[i]}
						</span>
						<span class="nav-link-label">{link.title}</span>
					</a>
				))
			}
		</div>
		<div class="nav-foot mt-auto sm:hidden">
			<span class="nav-foot-eyebrow">{tCommon.languageLabel}</span>
			<LanguageToggle />
		</div>
	</nav>
	<Search />
	<span class="hidden sm:inline-flex"><LanguageToggle /></span>
	<ThemeToggle />
	<mobile-button>
		<button
			aria-expanded="false"
			aria-haspopup="menu"
			class="group focus-visible:ring-accent relative z-50 ms-4 h-7 w-7 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 sm:invisible sm:hidden"
			id="toggle-navigation-menu"
			type="button"
		>
			<span class="sr-only">Open main menu</span>
			<svg
				aria-hidden="true"
				class="absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
				fill="none"
				focusable="false"
				id="line-svg"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
				></path>
			</svg>
			<svg
				aria-hidden="true"
				class="text-accent absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
				fill="none"
				focusable="false"
				id="cross-svg"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
	</mobile-button>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
				document.body.style.overflow = this.#menuOpen ? "hidden" : "";
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);

	// Compass behavior on the logo
	const bezel = document.querySelector<SVGGElement>(".logo-mark .compass-bezel");
	if (bezel) {
		const debugOn = new URLSearchParams(window.location.search).has("compass-debug");
		let debugEl: HTMLDivElement | null = null;
		if (debugOn) {
			debugEl = document.createElement("div");
			debugEl.style.cssText =
				"position:fixed;bottom:12px;right:12px;z-index:9999;background:rgba(0,0,0,0.8);color:#0f0;font:11px/1.4 monospace;padding:8px 12px;border-radius:6px;max-width:240px;white-space:pre;";
			debugEl.textContent = "[compass] waiting...";
			document.body.appendChild(debugEl);
		}
		const log = (msg: string) => {
			console.log(msg);
			if (debugEl) debugEl.textContent = msg;
		};

		let currentAngle = 0;
		const setAngle = (target: number) => {
			const diff = (((target - currentAngle) % 360) + 540) % 360 - 180;
			currentAngle += diff;
			bezel.style.transform = `rotate(${currentAngle}deg)`;
		};

		let mode: "compass" | "compass-lost" | "mouse" | null = null;

		const onMove = (e: MouseEvent) => {
			if (mode === "compass") return;
			if (mode == null) mode = "mouse";
			const rect = bezel.getBoundingClientRect();
			const cx = rect.left + rect.width / 2;
			const cy = rect.top + rect.height / 2;
			const dx = e.clientX - cx;
			const dy = e.clientY - cy;
			const angle = (Math.atan2(dy, dx) * 180) / Math.PI + 90;
			setAngle(angle);
		};

		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let wanderTimeout: number | null = null;

		const stopLostCompass = () => {
			if (wanderTimeout != null) {
				clearTimeout(wanderTimeout);
				wanderTimeout = null;
			}
		};

		const startLostCompass = () => {
			if (mode === "compass" || mode === "compass-lost") return;
			if (reducedMotion) return;
			mode = "compass-lost";
			log("[compass] no usable data, simulating lost compass");
			const wander = () => {
				if (mode !== "compass-lost") return;
				const bigSwing = Math.random() < 0.25;
				const magnitude = bigSwing
					? 120 + Math.random() * 80
					: 30 + Math.random() * 70;
				const direction = Math.random() < 0.5 ? 1 : -1;
				setAngle(currentAngle + magnitude * direction);
				const delay = 600 + Math.random() * 1400;
				wanderTimeout = window.setTimeout(wander, delay);
			};
			wander();
		};

		const compassHandler = (e: DeviceOrientationEvent & { webkitCompassHeading?: number }) => {
			let heading: number | null = null;
			let source = "none";
			if (e.webkitCompassHeading != null) {
				heading = e.webkitCompassHeading;
				source = "webkit";
			} else if (e.absolute && e.alpha != null) {
				heading = 360 - e.alpha;
				source = "absolute";
			} else if (e.alpha != null) {
				heading = 360 - e.alpha;
				source = "relative";
			}
			log(
				`[compass] ${e.type}\nabsolute: ${e.absolute}\nalpha: ${e.alpha?.toFixed(1)}\nwebkit: ${e.webkitCompassHeading?.toFixed(1) ?? "n/a"}\nheading: ${heading?.toFixed(1) ?? "n/a"} (${source})`,
			);
			if (heading != null) {
				if (mode === "compass-lost") stopLostCompass();
				mode = "compass";
				setAngle(-heading);
			}
		};

		const attachOrientationListener = () => {
			const win = window as unknown as {
				addEventListener: (type: string, handler: EventListener) => void;
				ondeviceorientationabsolute?: unknown;
			};
			let absoluteFired = false;
			if ("ondeviceorientationabsolute" in win) {
				log("[compass] attached: deviceorientationabsolute");
				win.addEventListener("deviceorientationabsolute", ((e: Event) => {
					absoluteFired = true;
					compassHandler(e as DeviceOrientationEvent & { webkitCompassHeading?: number });
				}) as EventListener);
			} else {
				log("[compass] no absolute event, listening to deviceorientation only");
			}
			win.addEventListener("deviceorientation", ((e: Event) => {
				if (!absoluteFired)
					compassHandler(e as DeviceOrientationEvent & { webkitCompassHeading?: number });
			}) as EventListener);
		};

		const armLostFallback = () => {
			window.setTimeout(() => {
				if (mode !== "compass") startLostCompass();
			}, 2000);
		};

		const enableCompass = async () => {
			mode = "compass";
			document.removeEventListener("mousemove", onMove);
			type IOSPermission = typeof DeviceOrientationEvent & {
				requestPermission?: () => Promise<"granted" | "denied">;
			};
			const cls = DeviceOrientationEvent as IOSPermission;
			if (typeof cls.requestPermission === "function") {
				try {
					const state = await cls.requestPermission();
					console.log("[compass] iOS permission:", state);
					if (state === "granted") {
						attachOrientationListener();
						armLostFallback();
					} else {
						mode = null;
						startLostCompass();
					}
				} catch (err) {
					console.log("[compass] iOS permission error:", err);
					mode = null;
					startLostCompass();
				}
			} else {
				attachOrientationListener();
				armLostFallback();
			}
		};

		const hasTouch =
			"ontouchstart" in window ||
			navigator.maxTouchPoints > 0 ||
			window.matchMedia("(pointer: coarse)").matches;

		if (hasTouch) {
			document.addEventListener("touchstart", enableCompass, { once: true, passive: true });
		} else {
			document.addEventListener("mousemove", onMove);
		}
	}
</script>

<style>
	/* ──────────────────────────────────────────────────────────────
	   Header chrome — spans the full viewport with editorial padding,
	   matching the home page hero overlay. The home page additionally
	   pulls this header into absolute positioning over the hero via
	   its own scoped style; on every other page the header sits at
	   the top in normal flow with a generous bottom margin.
	   ────────────────────────────────────────────────────────────── */
	.lb-header {
		padding: 1rem 1.25rem;
		margin-bottom: 3rem;
	}
	@media (min-width: 880px) {
		.lb-header {
			padding: 1.5rem 3rem;
			margin-bottom: 4rem;
		}
	}
	@media (min-width: 1280px) {
		.lb-header {
			padding: 1.75rem 5rem;
		}
	}

	.logo-link {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--color-global-text);
		text-decoration: none;
		transition: color 150ms ease;
	}
	.logo-link:hover {
		color: var(--color-accent);
	}
	.logo-mark {
		display: inline-block;
		height: 2.75rem;
		width: 2.75rem;
		flex-shrink: 0;
	}
	.logo-mark :global(svg) {
		display: block;
		height: 100%;
		width: 100%;
	}
	.logo-mark :global(.compass-bezel) {
		transform-origin: 50px 50px;
		transition: transform 350ms ease-out;
	}
	@media (prefers-reduced-motion: reduce) {
		.logo-mark :global(.compass-bezel) {
			transition: none;
		}
	}
	@media (min-width: 640px) {
		.logo-mark {
			height: 3.25rem;
			width: 3.25rem;
		}
	}
	@media (min-width: 1280px) {
		.logo-mark {
			height: 3.75rem;
			width: 3.75rem;
		}
	}

	/* Wordmark — small mono caps next to the compass, like a
	   publisher's imprint line. */
	.logo-wordmark {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
		line-height: 1;
	}
	@media (min-width: 640px) {
		.logo-wordmark {
			font-size: 0.75rem;
			letter-spacing: 0.2em;
		}
	}
	/* On the narrowest phones, hide the wordmark so the right-side
	   chrome (search/theme/hamburger) doesn't crowd. */
	@media (max-width: 380px) {
		.logo-wordmark {
			display: none;
		}
	}

	/* ──────────────────────────────────────────────────────────────
	   Mobile menu shell — full-screen overlay that respects iOS
	   dynamic toolbars and the home-indicator safe area so the
	   language footer is never hidden behind browser chrome.
	   ────────────────────────────────────────────────────────────── */
	.nav-menu {
		height: 100dvh;
		padding-bottom: max(2.5rem, calc(env(safe-area-inset-bottom) + 1.5rem));
	}
	@supports not (height: 100dvh) {
		.nav-menu {
			height: 100vh;
		}
	}
	@media (min-width: 640px) {
		.nav-menu {
			height: auto;
			padding-bottom: 0;
		}
	}

	/* ──────────────────────────────────────────────────────────────
	   Nav links — refined to read as chrome, not body.
	   Mobile (full-screen menu): editorial chapter list — Roman numeral
	   gutter, display-font label, hairline dividers between rows.
	   Desktop: small mono caps, letter-spaced, with a brass underline
	   that draws in on hover and stays under the current page.
	   ────────────────────────────────────────────────────────────── */
	.nav-list {
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
	}
	.nav-link {
		position: relative;
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		align-items: baseline;
		column-gap: 1rem;
		padding: 1.1rem 0;
		font-family: var(--font-mono);
		text-decoration: none;
		color: var(--color-global-text);
		border-bottom: 1px solid color-mix(in oklab, var(--color-global-text) 12%, transparent);
		transition: color 200ms ease;
	}
	.nav-link-num {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		color: var(--color-muted);
		font-weight: 600;
		transition: color 200ms ease;
	}
	.nav-link-label {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 8vw, 2.5rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.02em;
		font-variation-settings:
			"opsz" 36,
			"SOFT" 30,
			"WONK" 0;
	}
	.nav-link:hover,
	.nav-link.is-current {
		color: var(--color-accent);
	}
	.nav-link:hover .nav-link-num,
	.nav-link.is-current .nav-link-num {
		color: var(--color-accent);
	}

	.nav-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid color-mix(in oklab, var(--color-global-text) 18%, transparent);
	}
	.nav-foot-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--color-accent);
	}

	@media (min-width: 640px) {
		.nav-list {
			border-top: none;
		}
		.nav-foot {
			display: none;
		}
		.nav-link {
			display: inline-block;
			padding: 0.45rem 0.9rem;
			border-bottom: none;
		}
		.nav-link-num {
			display: none;
		}
		.nav-link-label {
			font-family: var(--font-mono);
			font-size: 0.6875rem;
			font-weight: 600;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			line-height: inherit;
			font-variation-settings: normal;
		}
		.nav-link::after {
			content: "";
			position: absolute;
			left: 0.9rem;
			right: 0.9rem;
			bottom: 0.15rem;
			height: 1px;
			background: var(--color-accent);
			transform: scaleX(0);
			transform-origin: left center;
			transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
		}
		.nav-link:hover::after,
		.nav-link.is-current::after {
			transform: scaleX(1);
		}
		@media (prefers-reduced-motion: reduce) {
			.nav-link::after {
				transition: none;
			}
		}
	}
</style>
