---
import fs from "node:fs";
import path from "node:path";
import LanguageToggle from "@/components/LanguageToggle.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getLangFromUrl, localizeUrl, useTranslations } from "@/i18n/utils";

const markSvg = fs.readFileSync(
	path.resolve("./src/assets/img/logo/svg/mark.svg"),
	"utf-8",
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).nav;
const menuLinks: { path: string; title: string }[] = [
	{ path: localizeUrl("/", lang), title: t.home },
	{ path: localizeUrl("/about/", lang), title: t.about },
	{ path: localizeUrl("/portfolio/", lang), title: t.portfolio },
	{ path: localizeUrl("/posts/", lang), title: t.writing },
	{ path: localizeUrl("/cv/", lang), title: t.cv },
	{ path: localizeUrl("/contact/", lang), title: t.contact },
];
---

<header class="group relative z-10 mb-20 flex items-center" id="main-header">
	<a aria-current={false} aria-label="Jose Barbosa - home" class="logo-link" href={localizeUrl("/", lang)}>
		<span aria-hidden="true" class="logo-mark" set:html={markSvg} />
	</a>
	<nav
		aria-label="Main menu"
		class="bg-global-bg/95 fixed inset-x-0 top-0 z-40 hidden h-screen flex-col items-stretch px-8 pt-24 pb-10 backdrop-blur-md group-[.menu-open]:flex sm:static sm:inset-auto sm:z-auto sm:ms-8 sm:flex sm:h-auto sm:flex-row sm:items-center sm:gap-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
		id="navigation-menu"
	>
		<div class="flex flex-1 flex-col gap-1 sm:flex-row sm:gap-0">
			{
				menuLinks.map((link, i) => (
					<a
						aria-current={Astro.url.pathname === link.path ? "page" : false}
						class:list={[
							"nav-link group/link relative block py-3 text-2xl font-semibold sm:px-4 sm:py-0 sm:text-sm sm:hover:underline",
							Astro.url.pathname === link.path ? "text-accent" : "text-global-text",
						]}
						href={link.path}
					>
						<span class="text-muted me-3 text-xs font-mono sm:hidden">
							{String(i + 1).padStart(2, "0")}
						</span>
						{link.title}
					</a>
				))
			}
		</div>
		<div class="mt-auto flex items-center justify-between border-t border-global-text/10 pt-6 sm:hidden">
			<span class="text-muted text-xs font-semibold uppercase tracking-wider">Language</span>
			<LanguageToggle />
		</div>
	</nav>
	<Search />
	<span class="hidden sm:inline-flex"><LanguageToggle /></span>
	<ThemeToggle />
	<mobile-button>
		<button
			aria-expanded="false"
			aria-haspopup="menu"
			class="group focus-visible:ring-accent relative z-50 ms-4 h-7 w-7 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 sm:invisible sm:hidden"
			id="toggle-navigation-menu"
			type="button"
		>
			<span class="sr-only">Open main menu</span>
			<svg
				aria-hidden="true"
				class="absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
				fill="none"
				focusable="false"
				id="line-svg"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
				></path>
			</svg>
			<svg
				aria-hidden="true"
				class="text-accent absolute start-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
				fill="none"
				focusable="false"
				id="cross-svg"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
	</mobile-button>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);

	// Compass behavior on the logo
	const bezel = document.querySelector<SVGGElement>(".logo-mark .compass-bezel");
	if (bezel) {
		const debugOn = new URLSearchParams(window.location.search).has("compass-debug");
		let debugEl: HTMLDivElement | null = null;
		if (debugOn) {
			debugEl = document.createElement("div");
			debugEl.style.cssText =
				"position:fixed;bottom:12px;right:12px;z-index:9999;background:rgba(0,0,0,0.8);color:#0f0;font:11px/1.4 monospace;padding:8px 12px;border-radius:6px;max-width:240px;white-space:pre;";
			debugEl.textContent = "[compass] waiting...";
			document.body.appendChild(debugEl);
		}
		const log = (msg: string) => {
			console.log(msg);
			if (debugEl) debugEl.textContent = msg;
		};

		let currentAngle = 0;
		const setAngle = (target: number) => {
			const diff = (((target - currentAngle) % 360) + 540) % 360 - 180;
			currentAngle += diff;
			bezel.style.transform = `rotate(${currentAngle}deg)`;
		};

		let mode: "compass" | "compass-idle" | "mouse" | null = null;

		const onMove = (e: MouseEvent) => {
			if (mode === "compass") return;
			if (mode == null) mode = "mouse";
			const rect = bezel.getBoundingClientRect();
			const cx = rect.left + rect.width / 2;
			const cy = rect.top + rect.height / 2;
			const dx = e.clientX - cx;
			const dy = e.clientY - cy;
			const angle = (Math.atan2(dy, dx) * 180) / Math.PI + 90;
			setAngle(angle);
		};

		const stopIdle = () => bezel.classList.remove("compass-idle");
		const startIdle = () => {
			if (mode === "compass-idle") return;
			mode = "compass-idle";
			bezel.style.transform = "";
			bezel.classList.add("compass-idle");
			log("[compass] no usable data, falling back to idle spin");
		};

		const compassHandler = (e: DeviceOrientationEvent & { webkitCompassHeading?: number }) => {
			let heading: number | null = null;
			let source = "none";
			if (e.webkitCompassHeading != null) {
				heading = e.webkitCompassHeading;
				source = "webkit";
			} else if (e.absolute && e.alpha != null) {
				heading = 360 - e.alpha;
				source = "absolute";
			} else if (e.alpha != null) {
				heading = 360 - e.alpha;
				source = "relative";
			}
			log(
				`[compass] ${e.type}\nabsolute: ${e.absolute}\nalpha: ${e.alpha?.toFixed(1)}\nwebkit: ${e.webkitCompassHeading?.toFixed(1) ?? "n/a"}\nheading: ${heading?.toFixed(1) ?? "n/a"} (${source})`,
			);
			if (heading != null) {
				if (mode === "compass-idle") {
					stopIdle();
					mode = "compass";
				}
				setAngle(-heading);
			}
		};

		const attachOrientationListener = () => {
			const win = window as unknown as {
				addEventListener: (type: string, handler: EventListener) => void;
				ondeviceorientationabsolute?: unknown;
			};
			let absoluteFired = false;
			if ("ondeviceorientationabsolute" in win) {
				log("[compass] attached: deviceorientationabsolute");
				win.addEventListener("deviceorientationabsolute", ((e: Event) => {
					absoluteFired = true;
					compassHandler(e as DeviceOrientationEvent & { webkitCompassHeading?: number });
				}) as EventListener);
			} else {
				log("[compass] no absolute event, listening to deviceorientation only");
			}
			win.addEventListener("deviceorientation", ((e: Event) => {
				if (!absoluteFired)
					compassHandler(e as DeviceOrientationEvent & { webkitCompassHeading?: number });
			}) as EventListener);
		};

		const armIdleFallback = () => {
			window.setTimeout(() => {
				if (mode !== "compass") startIdle();
			}, 2000);
		};

		const enableCompass = async () => {
			mode = "compass";
			document.removeEventListener("mousemove", onMove);
			type IOSPermission = typeof DeviceOrientationEvent & {
				requestPermission?: () => Promise<"granted" | "denied">;
			};
			const cls = DeviceOrientationEvent as IOSPermission;
			if (typeof cls.requestPermission === "function") {
				try {
					const state = await cls.requestPermission();
					console.log("[compass] iOS permission:", state);
					if (state === "granted") {
						attachOrientationListener();
						armIdleFallback();
					} else {
						startIdle();
					}
				} catch (err) {
					console.log("[compass] iOS permission error:", err);
					startIdle();
				}
			} else {
				attachOrientationListener();
				armIdleFallback();
			}
		};

		const hasTouch =
			"ontouchstart" in window ||
			navigator.maxTouchPoints > 0 ||
			window.matchMedia("(pointer: coarse)").matches;

		if (hasTouch) {
			document.addEventListener("touchstart", enableCompass, { once: true, passive: true });
			window.setTimeout(() => {
				if (mode == null) startIdle();
			}, 4000);
		} else {
			document.addEventListener("mousemove", onMove);
		}
	}
</script>

<style>
	.logo-link {
		display: inline-flex;
		align-items: center;
		color: var(--color-global-text);
		transition: color 150ms ease;
	}
	.logo-link:hover {
		color: var(--color-accent);
	}
	.logo-mark {
		display: inline-block;
		height: 4rem;
		width: 4rem;
	}
	.logo-mark :global(svg) {
		display: block;
		height: 100%;
		width: 100%;
	}
	.logo-mark :global(.compass-bezel) {
		transform-origin: 50px 50px;
		transition: transform 200ms ease-out;
	}
	.logo-mark :global(.compass-bezel.compass-idle) {
		animation: compass-spin 24s linear infinite;
		transition: none;
	}
	@keyframes compass-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.logo-mark :global(.compass-bezel) {
			transition: none;
		}
		.logo-mark :global(.compass-bezel.compass-idle) {
			animation: none;
		}
	}
	@media (min-width: 640px) {
		.logo-mark {
			height: 5rem;
			width: 5rem;
		}
	}
</style>
